    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Google Fonts (Inter & Orbitron for Sci-Fi HUD Vibe) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Orbitron:wght@500;700;900&display=swap" rel="stylesheet">

    <!-- Chart.js for Historical Trends -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        tech: ['Orbitron', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            cyan: '#00d4ff',
                            emerald: '#00ff88',
                            pink: '#ff64c8',
                            purple: '#7b2cbf',
                            darkBg: '#090a15',
                            cardBg: 'rgba(17, 24, 39, 0.65)'
                        }
                    },
                    animation: {
                        'pulse-slow': 'pulse 3s cubic-bezier(0.4, 0, 0.6, 1) infinite',
                        'glow': 'glow 2s ease-in-out infinite alternate',
                    },
                    keyframes: {
                        glow: {
                            '0%': { boxShadow: '0 0 10px rgba(0,255,136,0.2)' },
                            '100%': { boxShadow: '0 0 25px rgba(0,255,136,0.6)' }
                        }
                    }
                }
            }
        }
    </script>

    <style>
        /* Custom Glowing & Glassmorphic Utilities */
        body {
            background: radial-gradient(circle at 50% 10%, #151833 0%, #080914 100%);
            min-height: 100vh;
            color: #f3f4f6;
            overflow-x: hidden;
        }

        .glass-panel {
            background: rgba(18, 24, 43, 0.65);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(0, 255, 136, 0.15);
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
        }

        .glass-panel-pink {
            background: rgba(26, 18, 38, 0.65);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 100, 200, 0.2);
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
        }

        .neon-text-cyan {
            text-shadow: 0 0 15px rgba(0, 212, 255, 0.8), 0 0 30px rgba(0, 212, 255, 0.4);
        }

        .neon-text-green {
            text-shadow: 0 0 15px rgba(0, 255, 136, 0.8), 0 0 30px rgba(0, 255, 136, 0.4);
        }

        .neon-text-pink {
            text-shadow: 0 0 15px rgba(255, 100, 200, 0.8), 0 0 30px rgba(255, 100, 200, 0.4);
        }

        /* Sci-Fi Hologram Ring Rotations */
        .ring-spin-cw {
            animation: spin 16s linear infinite;
        }
        .ring-spin-ccw {
            animation: spin-reverse 12s linear infinite;
        }

        @keyframes spin {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
        @keyframes spin-reverse {
            from { transform: rotate(360deg); }
            to { transform: rotate(0deg); }
        }

        /* Reveal Animation Keyframes for 18s Mark */
        @keyframes revealPop {
            0% { opacity: 0; transform: scale(0.6) translateY(30px); filter: blur(12px); }
            60% { opacity: 1; transform: scale(1.05) translateY(-5px); filter: blur(0px); }
            100% { opacity: 1; transform: scale(1) translateY(0); }
        }

        .animate-team-reveal {
            animation: revealPop 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        /* Fan Blades Animation Dynamic Control */
        .fan-blades {
            transform-origin: center;
            transition: transform 0.1s linear;
        }

        /* Custom Range Slider Styling */
        input[type=range] {
            -webkit-appearance: none;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 9999px;
            height: 10px;
        }

        input[type=range]::-webkit-slider-thumb {
            -webkit-appearance: none;
            height: 24px;
            width: 24px;
            border-radius: 50%;
            background: linear-gradient(135deg, #ff64c8, #00d4ff);
            cursor: pointer;
            box-shadow: 0 0 15px rgba(255, 100, 200, 0.8);
            transition: transform 0.1s ease, box-shadow 0.2s ease;
        }

        input[type=range]::-webkit-slider-thumb:hover {
            transform: scale(1.2);
            box-shadow: 0 0 25px rgba(0, 212, 255, 1);
        }

        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: #090a15; }
        ::-webkit-scrollbar-thumb { background: rgba(0, 255, 136, 0.3); border-radius: 3px; }
    </style>
</head>
